{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [{ "source": "/little-boutique-productions", "destination": "/api/boutique" }],
  "functions": { "api/boutique.js": { "maxDuration": 120 } },
  "headers": [
    {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/og.jpg","headers":[{"key":"Cache-Control","value":"public, max-age=86400"}]},
    {"source":"/(.*)\\.html","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source":"/little-boutique-assets/(.*)","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ]
}
